{
  "name": "rangeguard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Hedging bot for concentrated liquidity pools with Hyperliquid DEX",
  "repository": {
    "type": "git",
    "url": "https://github.com/frxnnk/trading-bot-cgr"
  },
  "keywords": [
    "trading-bot",
    "uniswap",
    "hyperliquid",
    "hedging",
    "impermanent-loss"
  ],
  "author": "frxnnk",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev:bot": "pnpm --filter @rangeguard/bot dev",
    "dev:bot:testnet": "RANGEGUARD_ENV=testnet pnpm --filter @rangeguard/bot dev",
    "dev:bot:mainnet": "RANGEGUARD_ENV=mainnet pnpm --filter @rangeguard/bot dev",
    "dev:dashboard": "pnpm --filter @rangeguard/dashboard dev",
    "dev:dashboard:testnet": "RANGEGUARD_ENV=testnet pnpm --filter @rangeguard/dashboard dev",
    "dev:dashboard:mainnet": "RANGEGUARD_ENV=mainnet pnpm --filter @rangeguard/dashboard dev",
    "build": "pnpm -r build",
    "build:bot": "pnpm --filter @rangeguard/bot build",
    "build:dashboard": "pnpm --filter @rangeguard/dashboard build",
    "test": "pnpm -r test",
    "setup-keys": "tsx scripts/setup-keys.ts",
    "testnet-seed": "tsx scripts/testnet-seed.ts",
    "setup-testnet": "tsx scripts/setup-testnet.ts",
    "setup-mainnet": "RANGEGUARD_ENV=mainnet tsx scripts/setup-mainnet.ts",
    "demo-seed": "tsx scripts/demo-seed.ts",
    "simulate:range": "node --no-warnings --import tsx scripts/simulate-range-trading.ts",
    "backtest": "node --no-warnings --import tsx packages/backtest/src/cli.ts",
    "db:migrate": "pnpm --filter @rangeguard/db migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.57.0",
    "viem": "^2.47.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
