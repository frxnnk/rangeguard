# ══════════════════════════════════════════════════════════════════════
# AMBIENTE — testnet (default) o mainnet
# Controla: DB (bot-testnet.db / bot-mainnet.db),
#           vault (vault-testnet.enc / vault-mainnet.enc),
#           HL URLs (defaults por ambiente)
# ══════════════════════════════════════════════════════════════════════
RANGEGUARD_ENV=testnet

# ══════════════════════════════════════════════════════════════════════
# NIVEL 1: Solo dashboard (pnpm testnet-seed + pnpm dev:dashboard)
# No se necesita ninguna variable — todo tiene defaults.
# ══════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════
# NIVEL 2: Dashboard + bot con precios reales
# ══════════════════════════════════════════════════════════════════════

# REQUERIDO — URL HTTP del nodo RPC (Alchemy, Infura, o cualquier proveedor)
RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Opcional — WebSocket mejora reactividad (sub-segundo vs polling cada 5s)
# WS_ARBITRUM=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Otras chains (solo si monitoreas pools en esas redes)
# RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# WS_ETHEREUM=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# WS_BASE=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# WS_POLYGON=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ══════════════════════════════════════════════════════════════════════
# NIVEL 3: E2E con hedging en Hyperliquid testnet
# ══════════════════════════════════════════════════════════════════════

# REQUERIDO — password para el vault de private keys
VAULT_PASSWORD=

# Hyperliquid endpoints (defaults = testnet, descomentar mainnet para produccion)
HL_API_URL=https://api.hyperliquid-testnet.xyz
# HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid-testnet.xyz/ws

# ══════════════════════════════════════════════════════════════════════
# OPCIONALES — raramente necesitas cambiar estos
# ══════════════════════════════════════════════════════════════════════

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_API_KEY=              # Requerido en produccion, vacio = dev mode

# Alertas — Discord o Telegram webhook (recomendado para produccion)
# Discord: https://discord.com/api/webhooks/XXXX/YYYY
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
# ALERT_WEBHOOK_URL=

# Rutas (los defaults usan RANGEGUARD_ENV — raramente hay que cambiar)
# DB_PATH=                      # Default: ./data/bot-{env}.db
# VAULT_PATH=                   # Default: ~/.rangeguard/vault-{env}.enc

# Performance tuning
# DEBOUNCE_COUNT=3              # Confirmaciones antes de abrir hedge (2=más rápido, 4=menos falsos positivos)
# POLLING_INTERVAL_MS=5000      # Intervalo de polling de precios (ms)
# WALLET_CHECK_INTERVAL_MS=15000 # Intervalo de chequeo de wallets (ms)

# Logging
LOG_LEVEL=info                  # debug | info | warn | error

# Dry-run / paper trading — logs what orders would be placed but never sends to HL
# DRY_RUN=true

# Railway / Docker — seedear data de ejemplo en el primer deploy
# DEMO_SEED=true

# Railway / Docker — importar private keys al vault automaticamente
# Formato: alias:tipo:0xprivatekey,alias2:tipo2:0xprivatekey2
# Solo se ejecuta si el vault no existe todavia
# WALLET_KEYS=pool-eth-arb:protection:0xabc...,profit-global:profit:0xdef...
