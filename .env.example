# Master password for vault (or provide via stdin at startup)
VAULT_PASSWORD=

# Dashboard auth (required in production — leave empty for dev mode)
DASHBOARD_API_KEY=

# Alerts — Discord or Telegram webhook URL (optional but recommended)
# Discord: https://discord.com/api/webhooks/XXXX/YYYY
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
ALERT_WEBHOOK_URL=

# RPC URLs (override defaults)
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# WebSocket RPC URLs (for real-time event subscriptions)
WS_ETHEREUM=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
WS_ARBITRUM=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
WS_BASE=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
WS_POLYGON=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Hyperliquid (change to mainnet for production)
HL_API_URL=https://api.hyperliquid-testnet.xyz
# HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid-testnet.xyz/ws

# Database path (use absolute path to ensure bot + dashboard share the same DB)
# DB_PATH=C:/Users/youruser/dev/trading-bot-cgr/data/bot.db
DB_PATH=

# Vault path (default: ~/.trading-bot-cgr/vault.enc)
VAULT_PATH=

# Dashboard port
DASHBOARD_PORT=3000

# Log level (debug | info | warn | error)
LOG_LEVEL=info
